# Railway Postgres plugin provides this automatically (reference variable ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:pass@localhost:5432/huntplanner"

# Auth.js - generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app, e.g. https://idaho-hunt-planner.up.railway.app
AUTH_URL=""
# Magic-link email via Resend (https://resend.com). Without a key, sign-in links are printed to the server log (dev only).
AUTH_RESEND_KEY=""
EMAIL_FROM="Idaho Hunt Planner <login@yourdomain.com>"

# Sync job: identify yourself to IDFG so they can contact you instead of blocking you
SYNC_USER_AGENT="IdahoHuntPlanner/0.1 (+mailto:you@example.com)"
# Delay between requests to IDFG, ms (be polite - this is a public agency server)
SYNC_DELAY_MS="1200"

# Comma-separated emails that can see /admin (sync health)
ADMIN_EMAILS="you@example.com"
