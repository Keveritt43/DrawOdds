generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Species {
  DEER
  ELK
  PRONGHORN
  MOOSE
  BIGHORN
  GOAT
}

enum Residency {
  RESIDENT
  NONRESIDENT
}

enum HuntType {
  GENERAL
  CONTROLLED
}

enum Weapon {
  ANY
  ARCHERY
  MUZZLELOADER
  SHORT_RANGE
  OTHER
}

enum AntlerClass {
  ANTLERED
  ANTLERLESS
  EITHER
}

// ---------------------------------------------------------------- raw IDFG data

/// One row per species / year / drawing / hunt number (IDFG drawing-odds API).
model DrawOdds {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  id         String  @id // DEER|2025|1|1039
  species    Species
  year       Int
  draw       Int
  huntNumber Int
  areaName   String
  areaId     Int?
  permits    Int?
  resPermits Int?
  nrPermits  Int?
  apps1      Int?
  apps2      Int?
  resApps    Int?
  nrApps     Int?
  drew1      Int?
  drew2      Int?

  @@index([species, areaName])
  @@index([species, year, huntNumber])
}

/// Controlled-hunt harvest, one row per species / year / hunt number.
model ControlledHarvest {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  id         String  @id // ELK|2025|2029
  species    Species
  year       Int
  huntNumber Int
  areaName   String
  takeMethod String?
  hunters    Int?
  harvest    Int?
  successPct Float?
  days       Int?
  antlered   Int?
  antlerless Int?
  pct4       Float?
  pct5       Float?
  pctWt      Float?
  pctSpike   Float?
  pct6       Float?
  estWt      Int?
  estMule    Int?
  est4       Int?
  est5       Int?
  estSpike   Int?
  est6       Int?
  avgSize    Float? // moose: avg antler spread (in.); sheep / goat: avg horn length (in.)
  avgCircum  Float? // sheep / goat: avg horn circumference (in.)

  @@index([species, huntNumber])
}

/// General-season harvest, one row per species / year / unit / take method.
model GeneralHarvest {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  id         String  @id // DEER|2025|49|Any Weapon
  species    Species
  year       Int
  unit       String
  takeMethod String
  hunters    Int?
  harvest    Int?
  successPct Float?
  days       Int?
  antlered   Int?
  antlerless Int?
  pct4       Float?
  pct5       Float?
  pctWt      Float?
  pctSpike   Float?
  pct6       Float?
  estWt      Int?
  estMule    Int?
  est4       Int?
  est5       Int?
  estSpike   Int?
  est6       Int?

  @@index([species, unit])
}

/// Game Management Unit (IDFG GMU layer + unit.aspx page).
model Unit {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  name                String // "49", "36A" (unique per state: see @@id)
  idfgId              Int?     @unique
  elkZone             String?
  acres               Float?
  geometry            Json? // simplified GeoJSON geometry, WGS84
  bbox                Json? // [minX, minY, maxX, maxY]
  landOwnership       Json? // [{ manager, pct }]
  publicPct           Float?
  privatePct          Float?
  wildernessPct       Float?
  accessYesAcres      Float?
  accessYesCount      Int?
  boundaryChanged2022 Boolean  @default(false)
  herds               Json? // Colorado: the herd (data analysis unit) per species, { DEER: "D-19", ELK: "E-20" }
  landUpdatedAt       DateTime?
  updatedAt           DateTime @updatedAt

  // composite key: Colorado has a unit 70 too. Changed from name-only by prisma/prepush.sql (db push can't do it without a data-loss prompt)
  @@id([state, name])
}

/// Controlled hunt area (IDFG Hunting MapServer layer 4 + area.aspx page). AreaID matches the odds API.
model HuntArea {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  areaId         Int       @id
  name           String // "49", "36B-1"
  bigGame        String?
  description    String?
  geometry       Json?
  bbox           Json?
  acres          Float?
  units          Json? // [{ unit, pct }] - share of the hunt area inside each unit, computed from geometry
  landOwnership  Json?
  publicPct      Float?
  privatePct     Float?
  accessYesAcres Float?
  accessYesCount Int?
  landUpdatedAt  DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([name])
}

model AccessYesProperty {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  id        Int     @id
  name      String
  acres     Float?
  active    Boolean @default(true)
  geometry  Json?
  units     String[]
  updatedAt DateTime @updatedAt
}

/// Hunts offered this season (IDFG huntlist.aspx pages, one per unit and species).
model Hunt {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  idfgId      Int         @id
  year        Int
  species     Species
  type        HuntType
  huntNumber  Int?
  code        String? // the agency's hunt code when it isn't a number (Colorado "DM070O3R")
  areaName    String? // controlled hunts: hunt area from the regs
  source      String      @default("huntlist") // huntlist | regs | harvest
  name        String
  takeMethod  String
  weapon      Weapon
  antlerClass AntlerClass
  sexText     String
  openDate    DateTime?
  closeDate   DateTime?
  tags        Int? // null = unlimited / not stated
  youthOnly   Boolean     @default(false)
  units       String[]
  rawText     String?
  updatedAt   DateTime    @updatedAt

  summaries HuntSummary[]
  saved     SavedHunt[]

  @@index([species, type])
}

/// Precomputed, filter-ready row. Controlled hunt = one row; general hunt = one row per unit.
model HuntSummary {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  id          String      @id // "c:82056" or "g:80930:49"
  slug        String?     // readable address (unique: assignSlugs guarantees it): "deer-1016", "elk-unit-39-general-archery"
  huntId      Int
  hunt        Hunt        @relation(fields: [huntId], references: [idfgId], onDelete: Cascade)
  species     Species
  type        HuntType
  huntNumber  Int?
  name        String
  areaName    String?
  areaId      Int?
  unit        String? // general hunts: the unit this row is for
  units       String[] // all units touched
  weapon      Weapon
  takeMethod  String
  antlerClass AntlerClass
  openDate    DateTime?
  closeDate   DateTime?
  openMonth   Int?
  closeMonth  Int?
  months      Int[] // every calendar month the season is open (handles Dec-Jan seasons)
  seasonDays  Int[] // every open day, Jul 1 = 0 (src/lib/seasonDays.ts): the date-range filter
  closeDay    Int? // the last open day, same scale
  tags        Int?
  youthOnly   Boolean     @default(false)

  // draw (controlled only)
  resOddsLast Float?
  nrOddsLast  Float?
  resOdds5    Float?
  nrOdds5     Float?
  resAppsLast Int?
  nrAppsLast  Int?
  appsTrend   Float?
  oddsYears   Int         @default(0)
  oddsLastYear Int? // year of the most recent drawing
  resOddsPrev Float? // the drawing before that (null unless it was the year before)
  nrOddsPrev  Float?
  resAppsPrev Int?
  appsLast    Int? // first-choice applicants, residents + nonresidents, latest drawing
  nrAppsPrev  Int?
  nrPermitsLast Int? // tags nonresidents drew, latest drawing
  permitsLast Int? // all tags issued, latest drawing
  permitsPrev Int? // the drawing before that (year before only): tag changes
  leftoverYear Int? // IDFG's second drawing (leftover tags) for this hunt, latest year it had one
  leftoverTags Int?
  leftoverApps Int?
  leftoverDrew Int?
  secondDrewLast Int? // tags that reached 2nd-choice applicants, latest drawing
  secondAppsLast Int?

  // harvest
  success5         Float?
  hunters5         Int?
  harvest5         Int?
  whitetailPct5    Float?
  deerType         String? // WHITETAIL | MULE | MIXED
  bigPct5          Float?
  daysPerHunter5   Float? // hunter effort: days hunted per hunter (5-yr)
  daysPerHarvest5  Float? // days hunted per animal taken (5-yr)
  avgSize5         Float? // moose antler spread / sheep and goat horn length, harvest-weighted 5-yr avg (in.)
  antlerlessShare5 Float?
  harvestYears     Int     @default(0)
  harvestLastYear  Int?
  huntersSqMi      Float? // average yearly hunters (same years as success5) / square miles of the hunt area, unit or tag units
  successLast      Float?
  successPrev      Float? // the season before (null unless it was the year before)
  smallSample      Boolean @default(false)

  // ranking
  resTagAndFill Float?
  nrTagAndFill  Float?

  // land
  publicPct      Float?
  privatePct     Float?
  accessYesAcres Float?
  accessYesCount Int?
  accessYesPct   Float? // Access Yes! acres as % of the hunt area (or unit) - mostly private land, so NOT inside publicPct
  huntablePct    Float? // publicPct + accessYesPct, capped at 100
  acres          Float?

  boundaryChanged Boolean  @default(false)

  // nonresident general-season tag draw (one row per elk zone A/B tag, RD/WD deer unit tag)
  nrTag     Boolean @default(false)
  tagCode   String? // "ELK21" / "RD39" (hunt code you apply with)
  quota     Int? // nonresident quota for quotaYear
  quotaYear Int?
  capped    Boolean @default(false)
  nrDraw    Json? // { year, tags, applied: [1st..5th], drew: [...] }
  nrTagOdds  Json? // general seasons: the nonresident tag(s) that hunt it [{ label, code, odds, applied, drew, tags, year }]
  weapons    Weapon[] // nonresident tags: the weapons its seasons allow (empty = unknown)
  // DrawOdds Score (src/lib/score.ts): quality 0-100 and its parts; opportunity = quality x sqrt(5-yr odds)
  scoreQuality Int?
  scoreSuccess Int?
  scoreAccess  Int?
  scoreCrowd   Int?
  scoreTrophy  Int?
  scoreOppRes  Int?
  scoreOppNr   Int?
  tagSeasons Json? // elk A/B tag seasons: [{ weapon, sex, dates: [{ open, close }], notes }] + { year }

  // Colorado preference-point draw (src/lib/coOdds.ts). "Points" = adult first-choice applicants, latest draw.
  ptsRes      Int? // points needed: the level the licenses ran out at (0 when every first choice drew)
  ptsNr       Int?
  ptsResPct   Float? // share drawn at that level (0..1)
  ptsNrPct    Float?
  effRes      Float? // the same as one number: 6 points at 60% = 6.4 (src/lib/coOdds.ts effective())
  effNr       Float?
  projRes     Float? // next draw's cutoff, middle of the projection (effective points)
  projNr      Float?
  creepRes    Float? // points per year the cutoff has risen (5-year trend)
  creepNr     Float?
  secondChoice Boolean @default(false) // licenses reached 2nd+ choices last draw: drawable as a 2nd choice
  hybrid      Boolean @default(false) // some 5+ point applicants below the cutoff drew (hybrid draw)
  privateOnly Boolean @default(false) // private-land-only or Ranching for Wildlife license
  pointOdds   Json? // per pool: last draw's levels, projection quantiles, hybrid rate, history (src/lib/coHunt.ts)
  oddsByPts   Json? // { proj: { res: [odds at 0, 1, 2... points] , nr, yres, ynr }, last: { ... } }: list filters and sorting
  updatedAt       DateTime @updatedAt

  @@index([species, type, weapon, antlerClass])
  @@index([state])
  @@index([slug])
}

model SyncLog {
  id         Int       @id @default(autoincrement())
  step       String
  status     String // OK | CHECK | ERROR
  rows       Int       @default(0)
  details    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ---------------------------------------------------------------- accounts (Auth.js)

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  residency     Residency   @default(RESIDENT)
  createdAt     DateTime    @default(now())
  plan          Json?       // the application planner, synced across devices (newest edit wins)
  points        Json?       // preference points per state: { CO: { res: "NR", DEER: 3, ELK: 0, youth: false } }
  planUpdatedAt DateTime?
  accounts      Account[]
  sessions      Session[]
  saved         SavedHunt[]
  savedUnits    SavedUnit[]
  applications  Application[]
}

/// A unit the user starred (units are stable across seasons; hunts get renumbered)
model SavedUnit {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  userId    String
  unit      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, state, unit])
}

model SavedHunt {
  userId    String
  huntId    Int
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hunt      Hunt     @relation(fields: [huntId], references: [idfgId], onDelete: Cascade)

  @@id([userId, huntId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Nonresident general tag draw results (IDFG nonresident-draw-data PDF), one row per year + tag
model NrDraw {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  id      String  @id // "2026|ELK:McCall:A" / "2026|RD01"
  year    Int
  species Species
  kind    String // ELK | RD | WD
  code    String // "ELK:McCall:A" / "RD01"
  zone    String?
  tag     String? // A | B (elk)
  unit    String? // deer
  tags    Int
  applied Int[] // 1st..5th choice
  drew    Int[]

  @@index([code, year])
}

/// Nonresident general tag quotas (IDFG supplemental proclamation), one row per year + hunt code
model NrQuota {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  id      String  @id // "2027|ELK21"
  year    Int
  code    String // ELK21 / RD39 / WD10A
  quota   Int
  capped  Boolean @default(false)

  @@index([code, year])
}

/// Big-game migration studies (corridors and stopovers), loaded from data/migrations/<slug>/ by the
/// `migrations` sync step. geojson: FeatureCollection of polygons with properties.cls (a key in classes).
model MigrationStudy {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  slug         String    @id
  name         String
  species      Species
  herd         String
  summary      String
  caveat       String?   // the report's own warning, e.g. few collared animals
  methods      String?   // how the routes were modelled
  mapNote      String?   // why no routes are drawn (null when they are)
  source       String
  preparedBy   String?
  preparedDate String?
  studyStart   DateTime?
  studyEnd     DateTime?
  winterCount  String?
  stats        Json      // { avgMiles, maxMiles, minMiles, migrations, individuals, springMigrations, fallMigrations }
  timing       Json?     // { spring: { startAvg: "MM-DD", ... }, fall: { ... } }
  classes      Json      // [{ key, label, color, pattern?, acres }]
  units        String[]  // units the routes cross
  unitAcres    Json      // { "49": { "HIGH": 29176, ... } } (approximate)
  geojson      Json
  updatedAt    DateTime  @updatedAt
}

/// A hunter's own application history ("My Applications" on the account page).
model Application {
  state       String   @default("ID") // two-letter state; see docs/multi-state.md
  id        String   @id @default(cuid())
  userId    String
  year      Int
  kind      String   // NR_ELK | NR_DEER | CTL_DEER | CTL_ELK | CTL_PRONGHORN | MOOSE | BIGHORN | GOAT
  codes     String   // "ELK37, ELK21" / "1057, 1031"
  result    String   @default("PENDING") // PENDING | DREW | NOT_DRAWN
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year])
}

/// One hunt code's line in a Colorado Draw Recap report (primary draw), parsed by src/sync/co/recap.ts.
/// Pools: res / nr (adult), yres / ynr (youth), lppu / lppr (landowner unrestricted / restricted).
model DrawRecap {
  id           String  @id // "CO|DEER|2026|DM070O3R"
  state        String  @default("CO")
  species      Species
  year         Int
  code         String
  list         String?
  quota        Int?
  generalQuota Int?
  lppUnres     Int?
  lppRes       Int?
  youthPrefPct Float?
  youthPref    Int?
  nrCapPct     Float?
  nrCap        Int?
  hybridPct    Float?
  hybridCap    Int?
  apps         Int[] // general-draw applications, 1st..4th choice
  lppApps      Int[]
  drawnTotal   Int?
  balance      Int?
  drawn        Json // { res, nr, yres, ynr, lppu, lppr }
  cutoff       Json // { pool: { text, points, choice, leftover, drawnAtLevel, appsAtLevel } }
  pre          Json // first-choice applicants: { pool: { points: count } }
  post         Json // first-choice successful applicants, same shape
  preTotals    Json // [choice][pool]
  postTotals   Json
  updatedAt    DateTime @updatedAt

  @@index([state, species, code])
  @@index([state, species, year])
}
