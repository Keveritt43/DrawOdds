{
  "name": "idaho-hunt-planner",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "db:push": "prisma db push --skip-generate",
    "sync": "tsx src/sync/index.ts",
    "sync:full": "tsx src/sync/index.ts all --full",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.6.0",
    "@turf/turf": "^7.2.0",
    "maplibre-gl": "^5.3.0",
    "next": "^15.3.1",
    "next-auth": "5.0.0-beta.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
